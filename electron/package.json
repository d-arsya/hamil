{
  "name": "bidanku-desktop",
  "version": "1.0.0",
  "description": "BidanKu Desktop — Monitoring Ibu Hamil & Nifas (Windows)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bidanku.app",
    "productName": "BidanKu",
    "directories": { "output": "dist" },
    "files": ["main.js", "config.json"],
    "win": { "target": "nsis" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "BidanKu"
    }
  }
}
